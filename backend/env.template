# === Customer Instance Configuration ===
# Copy this file to .env and fill in the values.
# IMPORTANT: Never commit .env to git — it contains secrets.

# ─── Company Config ─────────────────────────────────────────────────────────
# Path to the company config JSON file (relative to /app inside the container)
COMPANY_CONFIG_PATH=config/company.json

# ─── Database ────────────────────────────────────────────────────────────────
# Connects to the 'db' service defined in docker-compose.yml
# Replace 'changeme' with the DB_PASSWORD value you set in docker-compose.yml
DATABASE_URL=postgresql://enrichment:changeme@db:5432/enrichment

# Postgres credentials (must match docker-compose.yml environment values)
DB_USER=enrichment
DB_PASSWORD=changeme
DB_NAME=enrichment

# ─── Google Cloud Vertex AI ──────────────────────────────────────────────────
# Your GCP project ID (the one with Vertex AI / Claude access enabled)
VERTEX_PROJECT_ID=your-gcp-project-id

# Region where Vertex AI Claude models are available
VERTEX_LOCATION=europe-west1

# Path to the service account JSON file (mounted as volume in docker-compose.yml)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# ─── API Keys ────────────────────────────────────────────────────────────────
# Tavily search API key — get one at https://app.tavily.com
TAVILY_API_KEY=tvly-REPLACE-WITH-YOUR-KEY

# Firecrawl API key — get one at https://firecrawl.dev (only needed if using firecrawl)
FIRECRAWL_API_KEY=fc-REPLACE-WITH-YOUR-KEY

# ─── Auth ────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -hex 32
# CHANGE THIS before deploying. Using the default is a security risk.
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32

# ─── Port ────────────────────────────────────────────────────────────────────
# Each customer instance runs on a different port on the VPS
# Shoppster: 8000, Merkur: 8001, NextCustomer: 8002, etc.
API_PORT=8000
